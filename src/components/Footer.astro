---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import contributorsByPage from '../data/contributors.json';

interface Contributor {
  name: string;
  login?: string;
  avatar?: string;
}

const routeId = Astro.locals.starlightRoute.id;
const contributors = (contributorsByPage as Record<string, Contributor[]>)[routeId] ?? [];
const issueBase = 'https://github.com/hackIDLE/Goog-Sec/issues/new';
---

<section class="page-trust" aria-label="Page provenance and feedback">
  <div class="page-trust__provenance">
    <div>
      <p class="page-trust__eyebrow">Page provenance</p>
      <p class="page-trust__copy">
        Community-maintained guidance. Use the edit link below to propose a sourced correction.
      </p>
    </div>
    {
      contributors.length > 0 && (
        <div class="page-contributors" aria-label="Page contributors">
          <span>Contributors</span>
          <span class="page-contributors__avatars">
            {contributors.slice(0, 6).map((contributor) =>
              contributor.login ? (
                <a
                  href={`https://github.com/${contributor.login}`}
                  title={contributor.name}
                  aria-label={contributor.name}
                >
                  <img src={contributor.avatar} alt="" width="32" height="32" loading="lazy" />
                </a>
              ) : (
                <span class="page-contributors__initial" title={contributor.name}>
                  {contributor.name.slice(0, 1).toUpperCase()}
                </span>
              ),
            )}
          </span>
        </div>
      )
    }
  </div>

  <div class="page-feedback" data-page-feedback>
    <div>
      <p class="page-trust__eyebrow">Was this page useful?</p>
      <p class="page-trust__copy" data-feedback-message>Help us prioritize the next improvement.</p>
    </div>
    <div class="page-feedback__actions" role="group" aria-label="Rate this page">
      <button type="button" data-feedback-value="helpful" aria-pressed="false">Yes</button>
      <button type="button" data-feedback-value="needs-work" aria-pressed="false">Not yet</button>
      <a href={issueBase} data-feedback-issue hidden>Open an issue</a>
    </div>
  </div>
</section>

<DefaultFooter><slot /></DefaultFooter>

<goog-sec-enhancements>
  <dialog class="image-lightbox" aria-label="Expanded image">
    <button class="image-lightbox__close" type="button" aria-label="Close image preview">Close</button>
    <img src="/Goog-Sec/assets/logo.svg" alt="" />
    <p class="image-lightbox__caption"></p>
  </dialog>
</goog-sec-enhancements>

<script>
  const feedbackStorageKey = 'goog-sec-page-feedback';

  class GoogSecEnhancements extends HTMLElement {
    connectedCallback() {
      this.setupFeedback();
      this.setupLightbox();
      this.setupMenuState();
    }

    setupMenuState() {
      const menuHost = document.querySelector<HTMLElement>('starlight-menu-button');
      const menuButton = menuHost?.querySelector<HTMLButtonElement>(
        'button[aria-controls="starlight__sidebar"]',
      );
      if (!menuHost || !menuButton || menuHost.dataset.googSecStateReady === 'true') return;
      menuHost.dataset.googSecStateReady = 'true';

      const sync = () => {
        const expanded = menuHost.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(expanded));
        menuButton.setAttribute('aria-label', expanded ? 'Close menu' : 'Menu');
      };

      new MutationObserver(sync).observe(menuHost, {
        attributes: true,
        attributeFilter: ['aria-expanded'],
      });
      sync();
    }

    setupFeedback() {
      const panel = document.querySelector<HTMLElement>('[data-page-feedback]');
      if (!panel || panel.dataset.ready === 'true') return;
      panel.dataset.ready = 'true';

      const path = window.location.pathname;
      const message = panel.querySelector<HTMLElement>('[data-feedback-message]');
      const issueLink = panel.querySelector<HTMLAnchorElement>('[data-feedback-issue]');
      const buttons = panel.querySelectorAll<HTMLButtonElement>('[data-feedback-value]');

      let saved: Record<string, string> = {};
      try {
        saved = JSON.parse(localStorage.getItem(feedbackStorageKey) || '{}');
      } catch {
        saved = {};
      }

      const apply = (value: string) => {
        buttons.forEach((button) => {
          const selected = button.dataset.feedbackValue === value;
          button.dataset.selected = String(selected);
          button.setAttribute('aria-pressed', String(selected));
        });
        if (message) {
          message.textContent =
            value === 'helpful'
              ? 'Thanks. Your response is saved in this browser.'
              : 'Thanks. Tell us what evidence or guidance is missing.';
        }
        if (issueLink) {
          issueLink.hidden = value !== 'needs-work';
          const issue = new URL(issueLink.href);
          issue.searchParams.set('title', `[Docs feedback] ${document.title.replace(' | Goog-Sec', '')}`);
          issue.searchParams.set(
            'body',
            `Page: ${window.location.href}\n\nWhat guidance, evidence, or context is missing?\n`,
          );
          issueLink.href = issue.toString();
        }
      };

      if (saved[path]) apply(saved[path]);

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const value = button.dataset.feedbackValue;
          if (!value) return;
          saved[path] = value;
          try {
            localStorage.setItem(feedbackStorageKey, JSON.stringify(saved));
          } catch {
            // Feedback remains visible even when storage is unavailable.
          }
          apply(value);
        });
      });
    }

    setupLightbox() {
      const dialog = this.querySelector<HTMLDialogElement>('.image-lightbox');
      const preview = dialog?.querySelector<HTMLImageElement>('img');
      const caption = dialog?.querySelector<HTMLElement>('.image-lightbox__caption');
      const close = dialog?.querySelector<HTMLButtonElement>('.image-lightbox__close');
      if (!dialog || !preview || !caption || !close) return;

      const open = (image: HTMLImageElement) => {
        preview.src = image.currentSrc || image.src;
        preview.alt = image.alt;
        caption.textContent = image.alt;
        caption.hidden = !image.alt;
        dialog.showModal();
        close.focus();
      };

      document.querySelectorAll<HTMLImageElement>('.sl-markdown-content img').forEach((image) => {
        if (image.closest('a') || image.dataset.lightboxReady === 'true') return;
        image.dataset.lightboxReady = 'true';
        image.classList.add('is-expandable');
        image.tabIndex = 0;
        image.setAttribute('role', 'button');
        image.setAttribute('aria-label', `${image.alt || 'Image'}: open full-size preview`);
        image.addEventListener('click', () => open(image));
        image.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            open(image);
          }
        });
      });

      close.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  }

  if (!customElements.get('goog-sec-enhancements')) {
    customElements.define('goog-sec-enhancements', GoogSecEnhancements);
  }
</script>
